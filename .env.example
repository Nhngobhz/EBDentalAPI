# Copy this file to `.env` and fill in real values.
# Every variable has a safe default in app/config.py, but you should at
# least set SECRET_KEY, DATABASE_URL, and your own credentials below
# before running this in anything beyond local testing.

APP_NAME=EBDentalSupply
# Setting ENVIRONMENT=production turns on a startup check (app/config.py) that
# refuses to boot on the development defaults - a placeholder/short SECRET_KEY,
# DEBUG=true, CORS_ORIGINS="*", or AUTO_CREATE_TABLES=true. It names whatever it
# finds, so a misconfigured deploy fails loudly instead of running insecurely.
ENVIRONMENT=development
DEBUG=true
# Public URL of this API - used to build the links inside confirmation /
# password-reset emails. Change this to your real domain in production.
BASE_URL=http://localhost:8000

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://store_user:store_password@localhost:5432/store_db
# Leave false and use `alembic upgrade head` instead (recommended).
# Only set true for quick local experiments.
AUTO_CREATE_TABLES=false

# --- Security ----------------------------------------------------------------
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ALGORITHM=HS256
# Staff/admin sessions. Short on purpose - these tokens can reprice the catalogue
# and edit other accounts, and expiry is the only thing that ends a session nobody
# logged out of. Not extendable: POST /auth/refresh refuses staff tokens.
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Customer sessions, counted as 14 days of INACTIVITY: the storefront quietly
# re-mints a customer's token (POST /auth/refresh) about once a day while they
# browse, so only a real fortnight away logs them out.
CUSTOMER_TOKEN_EXPIRE_MINUTES=20160
EMAIL_VERIFICATION_EXPIRE_MINUTES=1440
PASSWORD_RESET_EXPIRE_MINUTES=30

# --- Google Sign-In ------------------------------------------------------------
# Leave empty to disable the "Continue with Google" button entirely (the storefront
# then only offers email + password).
# 1. Google Cloud Console -> APIs & Services -> Credentials -> Create credentials
#    -> OAuth client ID -> Application type: "Web application".
# 2. Under "Authorized JavaScript origins" add every origin the storefront is
#    served from, e.g. http://localhost:5000 and https://yourdomain.com. (No
#    redirect URI is needed - the button never leaves the page.)
# 3. Copy the Client ID (…apps.googleusercontent.com) below AND into the Flask
#    app's own .env (GOOGLE_CLIENT_ID there too) - both sides need it, one to
#    render the button, this one to verify the token it produces.
# The client SECRET is deliberately not used anywhere; don't put it here.
GOOGLE_CLIENT_ID=

# --- CORS --------------------------------------------------------------------
# Comma-separated list, e.g. https://app.example.com,https://admin.example.com
# "*" is fine locally but means cross-origin callers are treated as anonymous:
# Access-Control-Allow-Credentials is only sent when this names real origins,
# because "*" plus credentials would let any site on the internet make
# credentialed calls here. Name the storefront's origin in production.
CORS_ORIGINS=*

# --- Outbound email (SMTP) ----------------------------------------------------
# Leave MAIL_USERNAME empty to run in "dry run" mode - emails get logged
# instead of sent, which is fine for local development.
# Example values for a Gmail account using an App Password:
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@yourdomain.com
MAIL_FROM_NAME=EBDentalSupply
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# --- Telegram bot --------------------------------------------------------------
# Leave both empty to disable Telegram notifications entirely.
# 1. Message @BotFather on Telegram -> /newbot -> copy the token below.
# 2. Send any message to your new bot (or add it to a group).
# 3. Open https://api.telegram.org/bot<TOKEN>/getUpdates and copy the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: if the group has "Topics" enabled, route errors/logins into
# separate topics by setting their message_thread_id (found the same way,
# via getUpdates, after posting in that topic). Leave empty for General.
TELEGRAM_ERROR_TOPIC_ID=
TELEGRAM_LOGIN_TOPIC_ID=
TELEGRAM_ORDER_TOPIC_ID=
# Random shared secret Telegram must present when calling POST /telegram/webhook/<secret>
# (see app/routers/telegram_webhook.py) - required for the order Delivered/Cancelled
# buttons to work. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Also requires BASE_URL above to be a real public HTTPS URL Telegram can reach (a local
# tunnel like ngrok/cloudflared works for testing) - on startup, if both are set, the app
# automatically registers the webhook with Telegram.
TELEGRAM_WEBHOOK_SECRET=

# --- KHQR payments ---------------------------------------------------------------
# Two interchangeable providers - configure ONE of them. If neither is set, KHQR
# checkout is disabled (customers can still choose Cash, which produces a quote).
#
# Which one is used: "auto" (default) picks PayWay when it's configured, otherwise
# Bakong-direct. Set "payway" or "bakong" to pin one explicitly - useful for
# testing against a personal QR while PayWay credentials stay in place.
KHQR_PROVIDER=auto
#
# Option 1 - ABA PayWay (recommended: generates the QR AND auto-confirms payment).
# Register as a PayWay merchant through ABA Bank; their integration team issues the
# merchant_id + API key and must whitelist this server's IP/domain before calls
# work. Point PAYWAY_API_BASE at https://checkout.payway.com.kh once they move you
# from sandbox to production.
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
PAYWAY_API_BASE=https://checkout-sandbox.payway.com.kh
#
# Option 2 - Bakong-direct: the QR is built locally to the KHQR spec, no
# registration needed to RECEIVE payments. Two ways to point it at your account:
#
# 2a (preferred) - the three payee fields from the KHQR spec's individual template.
# Get all three by saving your banking app's static "receive money / my QR" as an
# image and running:  python scripts/decode_khqr.py path/to/qr.png
# For a Bakong wallet the account id is a `your_name@bank` alias and the other two
# can stay empty. For a BANK account the account id is the bank's own Bakong id and
# the account number is what identifies you - ABA, for instance, issues
# abaakhppxxx@abaa plus your account number.
BAKONG_ACCOUNT_ID=
BAKONG_ACCOUNT_INFORMATION=
BAKONG_ACQUIRING_BANK=
# Minutes a generated QR stays payable (the spec requires an expiry on dynamic QRs).
KHQR_EXPIRY_MINUTES=60
#
# 2b (fallback) - paste the FULL payload of that same static QR and its payee
# routing is copied into every generated QR verbatim. That includes any proprietary
# tags the bank added (ABA's dual-currency QR carries an `abaP2P` tag 40), which can
# route the payment over the bank's own rail instead of Bakong's - in which case the
# automatic payment check below never sees it. Ignored when BAKONG_ACCOUNT_ID is set.
KHQR_STATIC_TEMPLATE=
# Merchant name/city embedded in the QR payload (shown in the customer's banking app).
KHQR_MERCHANT_NAME=EB DENTAL
KHQR_MERCHANT_CITY=Phnom Penh
# Optional, for automatic payment detection with Option 2: a developer token from
# https://api-bakong.nbc.gov.kh (renew when it expires). Without it, generated KHQR
# codes still work for paying, but staff must confirm with "Mark as Paid" on the
# admin Orders page.
BAKONG_API_TOKEN=
BAKONG_API_BASE=https://api-bakong.nbc.gov.kh

# --- File uploads --------------------------------------------------------------
UPLOAD_DIR=static/uploads
MAX_IMAGE_SIZE_MB=5
MAX_PDF_SIZE_MB=20

# --- File storage (Cloudflare R2) ------------------------------------------------
# Leave R2_ACCESS_KEY_ID empty to store uploads on local disk instead (under
# UPLOAD_DIR, served via /static) - handy for local development.
# 1. Create a bucket: Cloudflare dashboard -> R2 -> Create bucket.
# 2. Create an API token: R2 -> Manage API Tokens -> Create API Token
#    (Object Read & Write, scoped to the bucket) -> copy Access Key ID/Secret.
# 3. Enable public access on the bucket (R2.dev subdomain or a custom domain)
#    and put that base URL below.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# --- SAP Business One ------------------------------------------------------------
# Leave SAP_BASE_URL empty to disable the integration entirely (same pattern as
# MAIL_USERNAME / R2_ACCESS_KEY_ID above).
#
# Use the HOSTNAME, not an IP: connecting to the address returns a bare Apache 403
# before Service Layer ever sees the request, and the SAP certificate's SAN covers
# the server name rather than its current address. Note the server resolves via
# NetBIOS rather than DNS today, which does NOT work from inside Docker - add
# `extra_hosts: ["QPLUS365SERVER:<ip>"]` to docker-compose.yml, or a DNS record.
SAP_BASE_URL=https://QPLUS365SERVER:50000/b1s/v1
SAP_COMPANY_DB=
SAP_USERNAME=
SAP_PASSWORD=
# SAP ships a self-signed certificate. Set false until it is trusted locally.
SAP_VERIFY_TLS=true
# A SQL Server login for the catalogue sync to read the company database with. Leave
# empty for Windows authentication - which logs in as whoever starts the run, so the
# admin panel's sync button arrives as the ebdental-api service account. See
# SAP_SYNC.md, "Which account the query runs as".
SAP_DB_USER=
SAP_DB_PASSWORD=

# Writes are refused unless BOTH of these are satisfied: SAP_WRITE_ENABLED is true,
# AND SAP_WRITE_ALLOWED_COMPANY_DB exactly equals SAP_COMPANY_DB. An exact-match
# allowlist rather than anything clever, because the database named
# "EBDS_PRO_DB_LIVE" is in fact the TEST company - any rule that keyed on the word
# "LIVE" would protect precisely the wrong database.
SAP_WRITE_ENABLED=false
SAP_WRITE_ALLOWED_COMPANY_DB=

# --- SAP catalogue sync (scripts/sap_sync.py) --------------------------------------
# The item-master sync, which the Settings screen's "Catalogue Sync" tab can start on
# demand and Task Scheduler runs nightly. These two are about how it reaches SQL
# Server and how long it may take - the read itself needs no credential here.
#
# Transport: auto | odbc | local | ssh.
#   local  on the server, where store-api and SQL Server are the same machine
#   auto   from a development box (resolves to ssh via SAP_SSH_HOST)
# Set this to `local` in the server's .env; leaving it at auto there would make the
# server SSH to itself.
SAP_SYNC_TRANSPORT=auto
SAP_SYNC_TIMEOUT_SECONDS=1800
# Only used by the ssh transport, and read straight from the environment by
# scripts/sap_db_pull.py rather than through app/config.py.
SAP_SSH_HOST=ebserver
